# ── LINE Messaging API (บอทตอบข้อความ) ────────────────────────────────────
# developers.line.biz → Messaging API channel
LINE_CHANNEL_SECRET=your_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
# LINE user id ของเจ้าของ (ใช้ทดสอบ/ส่ง reminder ส่วนตัว)
LINE_USER_ID=your_line_user_id_here

# ── LINE Login (ล็อกอินเว็บ dashboard) ─────────────────────────────────────
# developers.line.biz → สร้าง LINE Login channel แยกจาก Messaging API
LINE_LOGIN_CLIENT_ID=your_line_login_channel_id
LINE_LOGIN_SECRET=your_line_login_channel_secret

# ── Web app / security ─────────────────────────────────────────────────────
# URL จริงของ deploy (Render). ใช้กำหนด callback + บังคับ cookie Secure ใน prod
APP_BASE_URL=http://localhost:8000
# random 32+ ตัว: `openssl rand -hex 32` — ห้ามใช้ค่า default ใน production
JWT_SECRET=change-me-in-production
# ป้องกันหน้า /admin และ /debug/ai — ตั้งเป็น random string
ADMIN_SECRET=change_this_to_a_random_string

# ── Database ───────────────────────────────────────────────────────────────
# local dev = SQLite ได้. บน Render/production ต้องเป็น Postgres ไม่งั้นข้อมูลหายตอน redeploy
# ตัวอย่าง Postgres: postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./tasks.db

# ── AI parser ──────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ── Scheduler / cron ───────────────────────────────────────────────────────
TIMEZONE=Asia/Bangkok
# ป้องกัน endpoint /cron/* — ต้องตรงกับ secret ที่ตั้งใน cron-job.org
CRON_SECRET=change_this_to_a_random_string
# ตั้ง true เฉพาะถ้าจะใช้ scheduler ในแอปแทน cron-job.org (ปกติปล่อยว่าง/false)
ENABLE_INTERNAL_SCHEDULER=false
